# Note: Fyers credentials are supplied per-request via the /api/v1/auth/login
# body, not via environment variables. The first successful TOTP login
# (client_id + totp_secret + pin) has its credentials saved automatically —
# encrypted, in the broker_credentials DB table — and that becomes the
# source of truth for POST /api/v1/auth/auto-login, which lets the frontend
# skip the manual login form on subsequent startups. No env config needed.

# How long a headless-login access token is cached before a fresh TOTP login
# is forced, in seconds. Optional — defaults to a sane value if unset.
# BROKER_TOKEN_CACHE_TTL_SECONDS=3600

# How often /market/ws re-polls REST quotes for subscribed symbols as a
# fallback (in seconds). Fyers rate-limits the quotes endpoint aggressively
# per app — raise this if you're seeing 429s with several tickers/pages open.
# MARKET_QUOTE_POLL_INTERVAL_SECONDS=3.0

# Persist daily OHLCV candles from Fyers for the configured underlyings.
# MARKET_DATA_BACKFILL_ENABLED=true
# MARKET_DATA_BACKFILL_SYMBOLS=NIFTY,BANKNIFTY
# MARKET_DATA_BACKFILL_INTERVAL_SECONDS=3600
# MARKET_DATA_BACKFILL_INITIAL_LOOKBACK_DAYS=365
# MARKET_DATA_BACKFILL_OVERLAP_DAYS=7

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/option_analytics

# Backs the JWT revocation blocklist so logout actually invalidates a token.
# REDIS_URL=redis://localhost:6380/0

# Encrypts the broker access token before it's persisted to the
# broker_sessions table (app.core.crypto). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left unset, the token is stored in plaintext (with a startup warning).
# BROKER_TOKEN_ENCRYPTION_KEY=

# App
APP_ENV=development
APP_DEBUG=true
# LOG_LEVEL=INFO
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=0.1
CORS_ORIGINS=http://localhost:3001
# APP_TITLE=Option Analytics Platform
# APP_VERSION=0.1.0
