# Note: Fyers credentials are normally supplied per-request via the
# /api/v1/auth/login body, not via environment variables. The FYERS_* vars
# below are optional and only used by POST /api/v1/auth/auto-login, which
# lets the frontend skip the manual login form on startup. Leave them unset
# to keep using the login form as normal.
# FYERS_APP_ID=XXXXXXXXX-100
# FYERS_API_SECRET=your_secret_key
# FYERS_CLIENT_ID=YR02352
# FYERS_TOTP_SECRET=your_base32_totp_secret
# FYERS_PIN=1234
# FYERS_REDIRECT_URI=http://127.0.0.1:3000
# FYERS_TRADING_MODE=paper

# How long a headless-login access token is cached before a fresh TOTP login
# is forced, in seconds. Optional — defaults to a sane value if unset.
# BROKER_TOKEN_CACHE_TTL_SECONDS=3600

# How often /market/ws re-polls REST quotes for subscribed symbols as a
# fallback (in seconds). Fyers rate-limits the quotes endpoint aggressively
# per app — raise this if you're seeing 429s with several tickers/pages open.
# MARKET_QUOTE_POLL_INTERVAL_SECONDS=3.0

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/option_analytics

# Encrypts the broker access token before it's persisted to the
# broker_sessions table (app.core.crypto). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left unset, the token is stored in plaintext (with a startup warning).
# BROKER_TOKEN_ENCRYPTION_KEY=

# App
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3001
# APP_TITLE=Option Analytics Platform
# APP_VERSION=0.1.0
